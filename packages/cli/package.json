{
  "name": "sqldex",
  "version": "0.5.0",
  "description": "Static analysis for MySQL schemas that live as .sql files in a repository.",
  "license": "MIT",
  "author": "Sergio Vallejo",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "homepage": "https://github.com/sdvallejo/sqldex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdvallejo/sqldex.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/sdvallejo/sqldex/issues"
  },
  "keywords": [
    "mysql",
    "sql",
    "lint",
    "linter",
    "static-analysis",
    "schema",
    "ddl",
    "language-server",
    "lsp"
  ],
  "bin": {
    "sqldex": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "development": "./src/main.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@sqldex/core": "^0.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  }
}
