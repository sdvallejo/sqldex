{
  "name": "sqldex",
  "displayName": "sqldex",
  "description": "Static analysis for MySQL schemas that live as .sql files in a repository.",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "publisher": "sqldex",
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "sql",
    "mysql",
    "schema",
    "linter",
    "language server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sdvallejo/sqldex.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/sdvallejo/sqldex/tree/main/editors/vscode#readme",
  "bugs": {
    "url": "https://github.com/sdvallejo/sqldex/issues"
  },
  "qna": "https://github.com/sdvallejo/sqldex/issues",
  "engines": {
    "vscode": "^1.91.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "sqldex starts a language server over the folder's own files, and a workspace can name the program to start through sqldex.server.path."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The catalog is built by reading .sql files from disk, so a folder that is not on one has nothing to read."
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sql",
    "workspaceContains:**/.sqldex.json"
  ],
  "contributes": {
    "configuration": {
      "title": "sqldex",
      "properties": {
        "sqldex.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that starts the language server. Empty means `sqldex-lsp` from your `PATH`, and failing that the server of the checkout this extension sits in.",
          "scope": "machine-overridable"
        },
        "sqldex.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the traffic between this extension and the server, in the sqldex output channel."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".sqldex.json",
        "url": "./schemas/sqldex.schema.json"
      }
    ],
    "commands": [
      {
        "command": "sqldex.rename",
        "title": "Rename symbol",
        "category": "sqldex"
      },
      {
        "command": "sqldex.restart",
        "title": "Restart the language server",
        "category": "sqldex"
      }
    ],
    "keybindings": [
      {
        "command": "sqldex.rename",
        "key": "f2",
        "when": "editorTextFocus && !editorReadonly && editorLangId == sql"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0",
    "vscode-languageserver": "^10.1.0"
  },
  "scripts": {
    "vscode:prepublish": "node bundle-server.js",
    "bundle": "node bundle-server.js",
    "package": "npx --yes @vscode/vsce package"
  }
}
