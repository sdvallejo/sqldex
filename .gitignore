# Installed, not written.
node_modules/

# Build and packaging artefacts, none of which exist until something is being published.
# `dist/` is what a publish compiles the sources into: npm cannot run TypeScript from a package —
# Node refuses to strip types under `node_modules` — so the tarball carries JavaScript that this
# repository never uses. `*.tgz` is what `npm pack` leaves behind, and packing is how a publish is
# checked before it happens.
dist/
*.tgz
*.tsbuildinfo

# The editor clients' own outputs: the server copied into the VS Code extension, and the extension
# packaged. Both are generated by `npm run package` from sources that are already here.
editors/vscode/server/
*.vsix

# Not `.vscode/`: this repository holds a VS Code extension, so a launch configuration checked in
# beside it is the point rather than an accident.

# What an editor or a file manager leaves lying around.
.DS_Store
*.swp
